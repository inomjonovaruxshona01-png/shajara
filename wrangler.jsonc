{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shajara",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Baza birinchi deployda avtomatik yaratiladi (wrangler >= 4.45).
  "d1_databases": [{ "binding": "DB", "database_name": "shajara-db","database_id": "62891f5a-9a49-448f-9517-8dbe5e6dd032" }],
  "observability": { "enabled": true }
}
